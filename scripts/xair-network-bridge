#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
cd "$ROOT"
if [[ -x "$ROOT/.venv/bin/python3" && -z "${XAIR_PYTHON:-}" ]]; then
  PY="$ROOT/.venv/bin/python3"
else
  PY="${XAIR_PYTHON:-python3}"
fi
exec "$PY" -m src.cli "$@"
