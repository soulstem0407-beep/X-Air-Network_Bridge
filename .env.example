# xair_network_bridge_server: captura USB. Vacío = se fuerza la X18 (nunca HDMI).
# xair_network_bridge_client no abre la mesa; usa JACK xair_net_bridge hacia REAPER.
XAIR_INPUT_DEVICE=
# Fallback PortAudio del cliente solo si JACK no arranca (nunca HDMI).
XAIR_OUTPUT_DEVICE=

# Network
# Replace 192.168.1.100 with YOUR X18/XR18 LAN address (documentation name: XAIR_DESK_IP).
# XAIR_DESK_IP=192.168.1.100
XAIR_UDP_PORT=50000
XAIR_BIND_HOST=0.0.0.0
# Other PC that should receive audio (the DAW machine). Same PC → 127.0.0.1
XAIR_PEER_HOST=127.0.0.1
# El cliente sólo acepta audio XBRI desde esta IP/hostname. Usa una IP fija
# en producción; "auto" aplaza el filtro hasta que discovery resuelva el peer.

# Buffer de jitter receptor; suelo (y valor fijo si adaptive=false). Orientativo 4–6 en LAN.
XAIR_JITTER_PACKETS=5
# true (defecto): crece/reduce el prebuffer según jitter EMA y underruns. false = fijo.
XAIR_JITTER_ADAPTIVE=true
# XAIR_JITTER_MIN=  (vacío = XAIR_JITTER_PACKETS)
# XAIR_JITTER_MAX=16
# XAIR_JITTER_COVER=3.0
# XAIR_JITTER_ADAPT_SEC=0.5

# FEC XOR (opcional). true = 1 paquete de paridad cada XAIR_FEC_GROUP datagramas de audio.
# Recuperación de exactamente 1 pérdida por grupo, en el hilo UDP (no en el callback JACK).
XAIR_FEC=false
XAIR_FEC_GROUP=3

# Opus (opcional). true = payload Opus en el hilo UDP send/recv. false = PCM/FLAC.
# JACK/PipeWire sigue tirando solo PCM. Activar en emisor y receptor.
XAIR_OPUS=false
XAIR_OPUS_BITRATE=128000
XAIR_OPUS_FRAME=20

# Return path DAW → mesa (opcional). OSC write-back en hilo de control; audio stereo aparte.
XAIR_RETURN_OSC=false
XAIR_RETURN_AUDIO=false
XAIR_RETURN_SAFETY=true
XAIR_RETURN_UDP_PORT=50001
# XAIR_RETURN_PEER_HOST=   (vacío = XAIR_PEER_HOST)
# XAIR_RETURN_INPUT_DEVICE=   (cliente: captura stereo DAW)
# XAIR_RETURN_OUTPUT_DEVICE=  (servidor: USB playback X18)
XAIR_RETURN_LISTEN_HOST=0.0.0.0
XAIR_RETURN_LISTEN_PORT=9002
XAIR_RETURN_DAW_HOST=127.0.0.1
XAIR_RETURN_DAW_PORT=9001

# Auto-discovery (opcional). true = mDNS/SSDP//xinfo + beacons de presencia.
# Audio UDP sigue en unicast. false = IPs manuales (XAIR_OSC_HOST / XAIR_PEER_HOST).
XAIR_DISCOVERY=false
# XAIR_OSC_HOST=auto
# XAIR_PEER_HOST=auto
# XAIR_DISCOVERY_WAIT_SEC=2.5
# XAIR_DISCOVERY_GROUP=239.255.77.77
# XAIR_DISCOVERY_PORT=50010
# XAIR_DISCOVERY_NAME=xair-network-bridge
# XAIR_DISCOVERY_STATE_PATH=.xair_discovery.json

# EQ / dynamics / FX OSC (opcional). Escritura en hilo de control; no en JACK/PipeWire.
# Requiere mesa XAIR_OSC_HOST. El snapshot lleva eq_health / dyn_health / fx_health.
XAIR_EQ=false
XAIR_DYN=false
XAIR_FX=false

# Grabación WAV por canal (sidecar). true = empieza al arrancar xair_network_bridge_client.
# start/stop en caliente: python -m src.cli record-start|record-stop  o dashboard (r / botones).
# No entra en el callback JACK/PipeWire ni bloquea UDP (cola + hilo xair-record).
XAIR_RECORD=false
# XAIR_RECORD_PATH=recordings

# Muestras/canal/datagrama. Con PCM24+18 ch, 21 ≈ MTU ethernet sin fragmentar (véase docs/LATENCY.md).
XAIR_SAMPLES_PER_PACKET=21

# Códec: PCM16 | PCM24 | FLAC (FLAC necesita libsndfile vía soundfile)
XAIR_CODEC=PCM24

# Tasa y canales (X18 clase USB habitual)
XAIR_SAMPLE_RATE=48000
XAIR_CHANNELS=18

# Cola corta en el emisor (1 = sin retardo extra)
XAIR_SEND_JITTER_DEPTH=1

# Log de métricas receptor (segundos). 0 = silenciar (excepto shutdown)
XAIR_METRICS_INTERVAL_SEC=5

# Solo Windows PortAudio WASAPI exclusivo si el puente puede monopolizar esa salida
XAIR_WASAPI_EXCLUSIVE=false

# --- Salida virtual Linux (JACK/PipeWire) ---
# xair_network_bridge_client sin XAIR_OUTPUT_DEVICE crea un cliente JACK xair_net_bridge
# full-duplex: N puertos _in (capture) + N _out (playback), mismos canales.
# false = sink Pulse module-null-sink + PortAudio (comportamiento anterior).
XAIR_VIRTUAL_PORT_NAMES=true
# XAIR_JACK_CLIENT_NAME=xair_net_bridge
# XAIR_AUTO_VIRTUAL_OUTPUT=true

# --- OSC (control X AIR; ver docs/OSC.md y docs/OSC_LAUNCHER.md) ---
XAIR_OSC_ENABLED=true
# Desk IP placeholder — put YOUR mixer address here (example: 192.168.1.100).
XAIR_OSC_HOST=192.168.1.100
# Alias read by osc-launcher (same IP as XAIR_OSC_HOST).
# XAIR_OSC_IP=192.168.1.100
XAIR_OSC_PORT=10024
XAIR_OSC_TIMEOUT=2.0
XAIR_OSC_XREMOTE=false
XAIR_OSC_XREMOTE_INTERVAL_SEC=8.0
XAIR_OSC_METER_SUB_ARG=9

# Sincronización analítica OSC + audio UDP (véase docs/SYNC.md)
XAIR_SYNC_ON_CLIENT=false
# XAIR_SYNC_STATE_PATH=.xair_sync_state.json
XAIR_SYNC_LEVEL_TOLERANCE_DB=6.0
XAIR_SYNC_REPORT_INTERVAL_SEC=5.0
# Dashboard: python -m src.cli dashboard   (TUI)  o  --http
# XAIR_DASHBOARD_INTERVAL_SEC=0.25

# --- systemd (python -m src.cli install-service / remove-service) ---
# User units by default (PipeWire/JACK). X18 host: --role server. DAW: --role client.
# XAIR_SERVICE_ROLE=client
# XAIR_SERVICE_STATE_PATH=.xair_service.json

# --- Empaquetado (python -m src.cli package-deb / package-tar) ---
# XAIR_PACKAGE_STATE_PATH=.xair_package.json

# --- Release (python -m src.cli build-release) ---
# SOURCE_DATE_EPOCH=1700000000
# XAIR_RELEASE_STATE_PATH=.xair_release.json
# CFLAGS=-O2 -g0 -DNDEBUG -fno-ident
# LDFLAGS=-s -Wl,--build-id=none -Wl,--as-needed

# --- REAPER OSC (opcional; python -m src.cli start-reaper-sync) ---
# Destino: IP/puerto donde REAPER escucha OSC (Control OSC, Local listen). Típico 8000.
XAIR_REAPER_HOST=127.0.0.1
XAIR_REAPER_PORT=8000
# Bind local para mensajes que REAPER envía hacia este puente (Destination port). Distinto del listen.
XAIR_REAPER_LISTEN_HOST=0.0.0.0
XAIR_REAPER_LISTEN_PORT=9001
# true (defecto): /xremote + snapshot inicial. false: GET-poll clásico.
XAIR_REAPER_USE_XREMOTE=true
XAIR_REAPER_POLL_INTERVAL_SEC=0.20
XAIR_REAPER_ECHO_SUPPRESS_SEC=0.25
# Vacío = usa XAIR_CHANNELS (máx. 18). Sends/buses: cuántos empujar en cada ciclo.
# XAIR_REAPER_CHANNELS=18
XAIR_REAPER_SENDS=4
XAIR_REAPER_BUSES=4

# --- Escenas OSC (python -m src.cli scene-dump PATH / scene-recall PATH) ---
# Solo control: nombres, faders, gain, pan, mute, sends, buses, LR. Sin audio UDP.
# Vacío = XAIR_CHANNELS. Sends/buses por defecto 4.
# XAIR_SCENE_CHANNELS=18
# XAIR_SCENE_SENDS=4
# XAIR_SCENE_BUSES=4
